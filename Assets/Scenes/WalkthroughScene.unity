  m_Script: {fileID: 11500000, guid: f1e9789ffd796e941aa59f9328c053e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  tutorialSteps:
  - speaker: 5
    note: Welcome
    layoutMode: 0
    lines:
    - text: Welcome to the walkthrough!
      expression: 1
      isAction: 0
    - text: Since you needed some help learning the ropes, we are going to teach
        you.
      expression: 0
      isAction: 0
    - text: I need you to lock in for me!
      expression: 4
      isAction: 0
    highlightTargets: []
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 2
    note: Inventory
    layoutMode: 1
    lines:
    - text: First, we need to get you some ore.
      expression: 0
      isAction: 0
    - text: Click the next day button to get 10 of those beautiful pieces of ore.
      expression: 1
      isAction: 0
    highlightTargets: []
    uiHighlightTargets:
    - {fileID: 59608367}
    pearlRewardOnComplete: 0
  - speaker: 4
    note: Resources
    layoutMode: 1
    lines:
    - text: Now, let's head into the forge.
      expression: 0
      isAction: 0
    - text: Hover over this building and click the craft button that pops up.
      expression: 4
      isAction: 0
    highlightTargets:
    - {fileID: 947860684}
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 4
    note: Turn Counter
    layoutMode: 1
    lines:
    - text: Click the tier 1 button to get to your craftables.
      expression: 0
      isAction: 0
    highlightTargets: []
    uiHighlightTargets:
    - {fileID: 0}
    pearlRewardOnComplete: 0
  - speaker: 4
    note: Enemy Gauge
    layoutMode: 0
    lines:
    - text: Now click a crude tool to get to see how to craft.
      expression: 0
      isAction: 0
    highlightTargets: []
    uiHighlightTargets:
    - {fileID: 0}
    pearlRewardOnComplete: 0
  - speaker: 4
    note: Next Day Button
    layoutMode: 1
    lines:
    - text: Now go ahead and craft that bad boy!
      expression: 1
      isAction: 0
    highlightTargets: []
    uiHighlightTargets:
    - {fileID: 0}
    pearlRewardOnComplete: 0
  - speaker: 5
    note: Buildings Overview
    layoutMode: 1
    lines:
    - text: Now, we wait a turn
      expression: 1
      isAction: 0
    highlightTargets: []
    uiHighlightTargets:
    - {fileID: 0}
    pearlRewardOnComplete: 0
  - speaker: 0
    note: NPC Hint
    layoutMode: 0
    lines:
    - text: Now, let's head over to the trade hut.
      expression: 3
      isAction: 0
    - text: Hover over this building and click the Trade button.
      expression: 1
      isAction: 0
    highlightTargets:
    - {fileID: 947860684}
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 0
    note: NPC Hint
    layoutMode: 0
    lines:
    - text: Click the crude tool. Notice the price of it.
      expression: 1
      isAction: 0
    highlightTargets: []
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 0
    note: NPC Hint
    layoutMode: 1
    lines:
    - text: Now, click the increase button to add your tool.
      expression: 1
      isAction: 0
    - text: Hover over this building and click the Trade button.
      expression: 1
      isAction: 0
    highlightTargets: []
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 0
    note: NPC Hint
    layoutMode: 1
    lines:
    - text: Click the sell button and you're done. Make sure to pay attention to
        the price changes each day.
      expression: 3
      isAction: 0
    - text: Hover over this building and click the Trade button.
      expression: 1
      isAction: 0
    highlightTargets: []
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 0
    note: NPC Hint
    layoutMode: 0
    lines:
    - text: Click the X button and you are out of here!
      expression: 3
      isAction: 0
    highlightTargets: []
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
  - speaker: 5
    note: NPC Hint
    layoutMode: 1
    lines:
    - text: Congratulations! You have finished the walkthrough. Now go save your
        Ocean Empire!
      expression: 3
      isAction: 0
    highlightTargets: []
    uiHighlightTargets: []
    pearlRewardOnComplete: 0
