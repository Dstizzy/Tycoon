  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: It extracts essential Ore every turn and can be upgraded to significantly
    boost your yield. However, heavy machinery is prone to jamming, and its deep-sea
    vibrations risk attracting the Kraken. If production halts, you must manually
    repair the facility using crafted Patch Kits or emergency Pearls. Monitor its
    status closely to secure your vital material supply.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5b214ad912be86240898f0c2d81510e7, type: 2}
